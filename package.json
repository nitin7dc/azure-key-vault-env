{
  "name": "azure-key-vault-env",
  "version": "3.0.0",
  "description": "Keep your Node.js app's environment variables in Azure Key Vault and load them into process.env at startup. One dependency; works with require and import.",
  "keywords": [
    "azure",
    "azure-key-vault",
    "key-vault",
    "keyvault",
    "environment-variables",
    "env",
    "dotenv",
    "secrets",
    "secrets-management",
    "configuration",
    "nodejs",
    "javascript"
  ],
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "sample": "node --env-file=.env sample.js",
    "test": "node --test \"test/**/*.test.{js,mjs}\""
  },
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Nitin Sharma",
    "email": "nitin@renebyte.xyz"
  },
  "license": "ISC",
  "dependencies": {
    "@azure/keyvault-secrets": "^4.11.2"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "neostandard": "^0.14.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nitin7dc/azure-key-vault-env.git"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib"
  ]
}
